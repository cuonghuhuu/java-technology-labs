<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 7</p><h1>Quản lý sản phẩm</h1><p class="subtitle">Quản lý giá và số lượng tồn</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/san-pham?action=new">+ Thêm sản phẩm</a></div><c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if><section class="card"><form class="search-form" method="get" action="${pageContext.request.contextPath}/san-pham"><div class="search-box"><input name="keyword" value="${keyword}" placeholder="Tìm theo mã, tên hoặc mô tả"><button class="btn btn-dark">Tìm kiếm</button><a class="btn btn-light" href="${pageContext.request.contextPath}/san-pham">Làm mới</a></div></form></section><section class="card"><div class="table-header"><div><h2>Danh sách sản phẩm</h2><p>Tổng số: <strong>${dsSanPham.size()}</strong> sản phẩm</p></div></div><div class="table-responsive"><table><thead><tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Giá (VNĐ)</th><th>Số lượng</th><th class="text-center">Thao tác</th></tr></thead><tbody><c:forEach var="sp" items="${dsSanPham}"><tr><td><strong>${sp.ma}</strong></td><td><a class="student-name" href="${pageContext.request.contextPath}/san-pham?action=detail&id=${sp.id}">${sp.ten}</a></td><td>${sp.moTa}</td><td>${sp.gia}</td><td><span class="badge">${sp.soLuong}</span></td><td><div class="actions"><a class="btn btn-small btn-info" href="${pageContext.request.contextPath}/san-pham?action=detail&id=${sp.id}">Xem</a><a class="btn btn-small btn-warning" href="${pageContext.request.contextPath}/san-pham?action=edit&id=${sp.id}">Sửa</a><a class="btn btn-small btn-danger js-delete" data-name="${sp.ten}" href="${pageContext.request.contextPath}/san-pham?action=delete&id=${sp.id}">Xóa</a></div></td></tr></c:forEach><c:if test="${empty dsSanPham}"><tr><td colspan="6" class="empty-state">Không tìm thấy sản phẩm phù hợp.</td></tr></c:if></tbody></table></div></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
