<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>${empty sanPham.id || sanPham.id == 0 ? 'Thêm sản phẩm' : 'Cập nhật sản phẩm'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container container-small"><div class="page-header"><div><p class="eyebrow">BÀI 7</p><h1>${empty sanPham.id || sanPham.id == 0 ? 'Thêm sản phẩm' : 'Cập nhật sản phẩm'}</h1></div></div><c:if test="${not empty error}"><div class="alert alert-danger">⚠ ${error}</div></c:if><section class="card form-card"><form method="post" action="${pageContext.request.contextPath}/san-pham"><input type="hidden" name="id" value="${sanPham.id}"><div class="form-grid"><div class="form-group"><label>Mã sản phẩm</label><input name="ma" value="${sanPham.ma}" required></div><div class="form-group"><label>Tên sản phẩm</label><input name="ten" value="${sanPham.ten}" required></div><div class="form-group"><label>Giá (VNĐ)</label><input name="gia" type="number" min="0.01" step="0.01" value="${sanPham.gia}" required></div><div class="form-group"><label>Số lượng</label><input name="soLuong" type="number" min="0" value="${sanPham.soLuong}" required></div></div><div class="form-group"><label>Mô tả</label><textarea name="moTa" rows="4">${sanPham.moTa}</textarea></div><div class="form-actions"><a class="btn btn-light" href="${pageContext.request.contextPath}/san-pham">Hủy</a><button class="btn btn-primary">Lưu</button></div></form></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
