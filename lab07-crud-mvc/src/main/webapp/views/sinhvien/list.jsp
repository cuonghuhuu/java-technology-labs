<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý sinh viên</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 1–5, 11</p><h1>Quản lý sinh viên</h1><p class="subtitle">CRUD, tìm kiếm và phân trang 5 dòng/trang</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/sinh-vien?action=new">+ Thêm sinh viên</a></div><c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if><section class="card"><form class="search-form" method="get" action="${pageContext.request.contextPath}/sinh-vien"><div class="search-box"><input name="keyword" value="${keyword}" placeholder="Tìm theo mã, họ tên hoặc lớp"><button class="btn btn-dark">Tìm kiếm</button><a class="btn btn-light" href="${pageContext.request.contextPath}/sinh-vien">Làm mới</a></div></form></section><section class="card"><div class="table-header"><div><h2>Danh sách sinh viên</h2><p>Tổng số: <strong>${totalSinhVien}</strong> sinh viên</p></div></div><div class="table-responsive"><table><thead><tr><th>ID</th><th>Mã SV</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th class="text-center">Thao tác</th></tr></thead><tbody><c:forEach var="sv" items="${dsSinhVien}"><tr><td><span class="id-badge">#${sv.id}</span></td><td><strong>${sv.maSinhVien}</strong></td><td><a class="student-name" href="${pageContext.request.contextPath}/sinh-vien?action=detail&id=${sv.id}">${sv.hoTen}</a></td><td>${sv.email}</td><td><span class="badge">${sv.lop}</span></td><td><div class="actions"><a class="btn btn-small btn-info" href="${pageContext.request.contextPath}/sinh-vien?action=detail&id=${sv.id}">Xem</a><a class="btn btn-small btn-warning" href="${pageContext.request.contextPath}/sinh-vien?action=edit&id=${sv.id}">Sửa</a><a class="btn btn-small btn-danger js-delete" data-name="${sv.hoTen}" href="${pageContext.request.contextPath}/sinh-vien?action=delete&id=${sv.id}">Xóa</a></div></td></tr></c:forEach><c:if test="${empty dsSinhVien}"><tr><td colspan="6" class="empty-state">Không tìm thấy sinh viên phù hợp.</td></tr></c:if></tbody></table></div><c:if test="${totalPages > 1}"><div class="form-actions"><c:if test="${currentPage > 1}"><a class="btn btn-light" href="${pageContext.request.contextPath}/sinh-vien?keyword=${keyword}&page=${currentPage - 1}">← Previous</a></c:if><c:forEach begin="1" end="${totalPages}" var="page"><a class="btn ${page == currentPage ? 'btn-dark' : 'btn-light'}" href="${pageContext.request.contextPath}/sinh-vien?keyword=${keyword}&page=${page}">${page}</a></c:forEach><c:if test="${currentPage < totalPages}"><a class="btn btn-light" href="${pageContext.request.contextPath}/sinh-vien?keyword=${keyword}&page=${currentPage + 1}">Next →</a></c:if></div></c:if></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
