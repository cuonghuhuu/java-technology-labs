<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>${empty sv.id || sv.id == 0 ? 'Thêm sinh viên' : 'Cập nhật sinh viên'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container container-small"><div class="page-header"><div><p class="eyebrow">SINH VIÊN</p><h1>${empty sv.id || sv.id == 0 ? 'Thêm sinh viên' : 'Cập nhật sinh viên'}</h1></div></div><c:if test="${not empty error}"><div class="alert alert-danger">⚠ ${error}</div></c:if><section class="card form-card"><form method="post" action="${pageContext.request.contextPath}/sinh-vien" id="studentForm"><input type="hidden" name="id" value="${sv.id}"><div class="form-grid"><div class="form-group"><label>Mã sinh viên</label><input id="maSinhVien" name="maSinhVien" value="${sv.maSinhVien}" required></div><div class="form-group"><label>Họ tên</label><input id="hoTen" name="hoTen" value="${sv.hoTen}" required></div><div class="form-group"><label>Email</label><input id="email" name="email" type="email" value="${sv.email}" required></div><div class="form-group"><label>Lớp</label><input id="lop" name="lop" value="${sv.lop}" required></div></div><div class="form-actions"><a class="btn btn-light" href="${pageContext.request.contextPath}/sinh-vien">Hủy</a><button class="btn btn-primary">Lưu</button></div></form></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
