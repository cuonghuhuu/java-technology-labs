<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>${empty diem.id || diem.id == 0 ? 'Nhập điểm' : 'Cập nhật điểm'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container container-small"><div class="page-header"><div><p class="eyebrow">BÀI 9</p><h1>${empty diem.id || diem.id == 0 ? 'Nhập điểm' : 'Cập nhật điểm'}</h1><p class="subtitle">Mỗi điểm phải từ 0 đến 10.</p></div></div><c:if test="${not empty error}"><div class="alert alert-danger">⚠ ${error}</div></c:if><section class="card form-card"><form method="post" action="${pageContext.request.contextPath}/diem"><input type="hidden" name="id" value="${diem.id}"><div class="form-grid"><div class="form-group"><label>Mã sinh viên</label><input name="maSinhVien" value="${diem.maSinhVien}" required></div><div class="form-group"><label>Họ tên</label><input name="hoTen" value="${diem.hoTen}" required></div><div class="form-group"><label>Điểm chuyên cần</label><input name="diemChuyenCan" type="number" min="0" max="10" step="0.1" value="${diem.diemChuyenCan}" required></div><div class="form-group"><label>Điểm giữa kỳ</label><input name="diemGiuaKy" type="number" min="0" max="10" step="0.1" value="${diem.diemGiuaKy}" required></div><div class="form-group"><label>Điểm cuối kỳ</label><input name="diemCuoiKy" type="number" min="0" max="10" step="0.1" value="${diem.diemCuoiKy}" required></div></div><div class="form-actions"><a class="btn btn-light" href="${pageContext.request.contextPath}/diem">Hủy</a><button class="btn btn-primary">Lưu</button></div></form></section></main></body></html>
