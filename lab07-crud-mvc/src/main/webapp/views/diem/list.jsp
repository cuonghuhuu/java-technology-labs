<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý điểm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 9</p><h1>Quản lý điểm</h1><p class="subtitle">Tổng kết = Chuyên cần 10% + Giữa kỳ 30% + Cuối kỳ 60%</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/diem?action=new">+ Nhập điểm</a></div><c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if><section class="card"><div class="table-responsive"><table><thead><tr><th>Mã SV</th><th>Họ tên</th><th>CC</th><th>GK</th><th>CK</th><th>Tổng kết</th><th>Xếp loại</th><th class="text-center">Thao tác</th></tr></thead><tbody><c:forEach var="diem" items="${dsDiem}"><tr><td>${diem.maSinhVien}</td><td><a class="student-name" href="${pageContext.request.contextPath}/diem?action=detail&id=${diem.id}">${diem.hoTen}</a></td><td>${diem.diemChuyenCan}</td><td>${diem.diemGiuaKy}</td><td>${diem.diemCuoiKy}</td><td><strong>${diem.diemTongKet}</strong></td><td><span class="badge">${diem.xepLoai}</span></td><td><div class="actions"><a class="btn btn-small btn-info" href="${pageContext.request.contextPath}/diem?action=detail&id=${diem.id}">Xem</a><a class="btn btn-small btn-warning" href="${pageContext.request.contextPath}/diem?action=edit&id=${diem.id}">Sửa</a><a class="btn btn-small btn-danger js-delete" data-name="${diem.hoTen}" href="${pageContext.request.contextPath}/diem?action=delete&id=${diem.id}">Xóa</a></div></td></tr></c:forEach><c:if test="${empty dsDiem}"><tr><td colspan="8" class="empty-state">Chưa có dữ liệu điểm.</td></tr></c:if></tbody></table></div></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
