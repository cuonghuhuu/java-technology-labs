<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý sách</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 6</p><h1>Quản lý sách</h1><p class="subtitle">CRUD sách bằng Servlet, JSP và Repository</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/sach?action=new">+ Thêm sách</a></div>
<c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if>
<section class="card"><form class="search-form" method="get" action="${pageContext.request.contextPath}/sach"><div class="search-box"><input name="keyword" value="${keyword}" placeholder="Tìm theo tên sách hoặc tác giả"><button class="btn btn-dark">Tìm kiếm</button><a class="btn btn-light" href="${pageContext.request.contextPath}/sach">Làm mới</a></div></form></section>
<section class="card"><div class="table-header"><div><h2>Danh sách sách</h2><p>Tổng số: <strong>${dsSach.size()}</strong> sách</p></div></div><div class="table-responsive"><table><thead><tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>NXB</th><th>Năm</th><th class="text-center">Thao tác</th></tr></thead><tbody><c:forEach var="sach" items="${dsSach}"><tr><td><strong>${sach.maSach}</strong></td><td><a class="student-name" href="${pageContext.request.contextPath}/sach?action=detail&id=${sach.id}">${sach.tenSach}</a></td><td>${sach.tacGia}</td><td>${sach.nhaXuatBan}</td><td>${sach.namXuatBan}</td><td><div class="actions"><a class="btn btn-small btn-info" href="${pageContext.request.contextPath}/sach?action=detail&id=${sach.id}">Xem</a><a class="btn btn-small btn-warning" href="${pageContext.request.contextPath}/sach?action=edit&id=${sach.id}">Sửa</a><a class="btn btn-small btn-danger js-delete" data-name="${sach.tenSach}" href="${pageContext.request.contextPath}/sach?action=delete&id=${sach.id}">Xóa</a></div></td></tr></c:forEach><c:if test="${empty dsSach}"><tr><td colspan="6" class="empty-state">Không tìm thấy sách phù hợp.</td></tr></c:if></tbody></table></div></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
