<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý lớp học</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 8</p><h1>Quản lý lớp học</h1></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/lop-hoc?action=new">+ Thêm lớp học</a></div><c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if><section class="card"><form class="search-form" method="get" action="${pageContext.request.contextPath}/lop-hoc"><div class="search-box"><input name="keyword" value="${keyword}" placeholder="Tìm theo mã hoặc tên lớp"><button class="btn btn-dark">Tìm kiếm</button><a class="btn btn-light" href="${pageContext.request.contextPath}/lop-hoc">Làm mới</a></div></form></section><section class="card"><div class="table-responsive"><table><thead><tr><th>Mã lớp</th><th>Tên lớp</th><th>Cố vấn học tập</th><th>Số SV</th><th class="text-center">Thao tác</th></tr></thead><tbody><c:forEach var="lop" items="${dsLopHoc}"><tr><td><strong>${lop.maLop}</strong></td><td>${lop.tenLop}</td><td>${lop.coVanHocTap}</td><td><span class="badge">${lop.soLuongSinhVien}</span></td><td><div class="actions"><a class="btn btn-small btn-warning" href="${pageContext.request.contextPath}/lop-hoc?action=edit&id=${lop.id}">Sửa</a><a class="btn btn-small btn-danger js-delete" data-name="${lop.tenLop}" href="${pageContext.request.contextPath}/lop-hoc?action=delete&id=${lop.id}">Xóa</a></div></td></tr></c:forEach><c:if test="${empty dsLopHoc}"><tr><td colspan="5" class="empty-state">Không tìm thấy lớp học.</td></tr></c:if></tbody></table></div></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
