<%@ page contentType="text/html;charset=UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Giỏ hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="/WEB-INF/jspf/header.jspf" %><main class="container"><div class="page-header"><div><p class="eyebrow">BÀI 10</p><h1>Giỏ hàng Session</h1><p class="subtitle">Dữ liệu giỏ hàng gắn với phiên đăng nhập hiện tại.</p></div></div><c:if test="${not empty param.success}"><div class="alert alert-success js-alert">✓ ${param.success}</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger js-alert">⚠ ${param.error}</div></c:if><section class="card"><div class="table-header"><div><h2>Sản phẩm có thể thêm</h2></div></div><div class="table-responsive"><table><thead><tr><th>Mã</th><th>Tên</th><th>Giá (VNĐ)</th><th>Tồn kho</th><th></th></tr></thead><tbody><c:forEach var="sp" items="${dsSanPham}"><tr><td>${sp.ma}</td><td>${sp.ten}</td><td>${sp.gia}</td><td>${sp.soLuong}</td><td><a class="btn btn-small btn-primary" href="${pageContext.request.contextPath}/gio-hang?action=add&id=${sp.id}">Thêm vào giỏ</a></td></tr></c:forEach></tbody></table></div></section><section class="card"><div class="table-header"><div><h2>Giỏ hàng của bạn</h2><p>Tổng tiền: <strong>${tongTien} VNĐ</strong></p></div></div><div class="table-responsive"><table><thead><tr><th>Sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody><c:forEach var="item" items="${cart}"><tr><td>${item.tenSanPham}</td><td>${item.gia}</td><td><form method="post" action="${pageContext.request.contextPath}/gio-hang"><input type="hidden" name="id" value="${item.sanPhamId}"><div class="search-box"><input name="soLuong" type="number" min="0" value="${item.soLuong}"><button class="btn btn-small btn-dark">Cập nhật</button></div></form></td><td><strong>${item.thanhTien}</strong></td><td><a class="btn btn-small btn-danger js-delete" data-name="${item.tenSanPham}" href="${pageContext.request.contextPath}/gio-hang?action=remove&id=${item.sanPhamId}">Xóa</a></td></tr></c:forEach><c:if test="${empty cart}"><tr><td colspan="5" class="empty-state">Giỏ hàng đang trống.</td></tr></c:if></tbody></table></div></section></main><script src="${pageContext.request.contextPath}/js/app.js"></script></body></html>
